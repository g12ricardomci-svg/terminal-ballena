//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//  🐋🟡 BALLENA DORADA · RANGO DE LA VELA MADRE
//  1) La VELA MADRE es una vela grande. Su cuerpo y sus mechas (máximo → mínimo) son el RANGO.
//  2) Si la vela siguiente es VERDE y más del 50 % de su cuerpo queda dentro del rango
//     → el precio va a buscar el MÁXIMO del rango (COMPRA).
//     Si es ROJA y más del 50 % de su cuerpo queda dentro → va a buscar el MÍNIMO (VENTA).
//  3) MADRE AL REVÉS: si la vela siguiente es del color contrario y ENVUELVE todo el cuerpo de la
//     madre → el precio sigue el color de esa vela, rompe el rango y recorre su tamaño.
//  SL al otro lado del rango. Cada operación se sigue en el gráfico (verde = llegó al TP, rojo = SL)
//  y el panel cuenta cuántas veces llegó al objetivo en todo el historial cargado.
//  Herramienta educativa, no es asesoría financiera.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
indicator("Ballena Dorada · Rango de la vela madre", shorttitle = "Rango Madre", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─── Ajustes ───
grpM    = "1) Vela madre"
atrMult = input.float(1.0, "Madre: rango ≥ N × ATR(14)", minval = 0, step = 0.1, group = grpM)
minBody = input.float(30, "Madre: cuerpo ≥ % de su rango", minval = 0, maxval = 100, step = 5, group = grpM)
pctIn   = input.float(50, "Vela siguiente: más de este % del cuerpo dentro del rango", minval = 0, maxval = 100, step = 5, group = grpM)
useRev  = input.bool(true, "Madre al revés (la vela siguiente envuelve el cuerpo de la madre)", group = grpM)

grpO     = "2) Operación"
maxBars  = input.int(20, "Velas máximas para llegar al objetivo", minval = 1, group = grpO)
slBuf    = input.float(0.1, "Margen del SL (× ATR)", minval = 0, step = 0.05, group = grpO)
spreadIn = input.float(0.0, "Spread a descontar (en precio: Oro 0.30 · BTC 20 · NAS100 1.35)", minval = 0, group = grpO)

grpV      = "3) Vista"
colRange  = input.color(color.new(color.purple, 85), "Color del rango", group = grpV)
showLines = input.bool(true, "Dibujar TP y SL", group = grpV)
showTable = input.bool(true, "Panel de estadística", group = grpV)

// ─── Cálculos ───
float atr   = ta.atr(14)
float mH    = high[1]
float mL    = low[1]
float mRng  = mH - mL
float mTop  = math.max(open[1], close[1])
float mBot  = math.min(open[1], close[1])
float top   = math.max(open, close)
float bot   = math.min(open, close)
float body  = top - bot

bool  madreOk = mRng > 0 and mRng >= atrMult * nz(atr[1]) and (mTop - mBot) >= minBody / 100 * mRng
float dentro  = body > 0 ? math.max(0.0, math.min(top, mH) - math.max(bot, mL)) / body * 100 : 0.0
bool  inOk    = madreOk and dentro > pctIn
bool  longIn  = inOk and close > open and close < mH
bool  shortIn = inOk and close < open and close > mL
bool  envuelve = useRev and top >= mTop and bot <= mBot and body > (mTop - mBot) and (high - low) >= atrMult * nz(atr)
bool  longRev  = envuelve and close > open and close[1] < open[1]
bool  shortRev = envuelve and close < open and close[1] > open[1]

int   sig = longRev ? 2 : shortRev ? -2 : longIn ? 1 : shortIn ? -1 : 0
int   dir = sig > 0 ? 1 : sig < 0 ? -1 : 0
bool  rev = math.abs(sig) == 2
float rH  = math.max(high, high[1])
float rL  = math.min(low, low[1])
float tp  = rev ? close + dir * (rH - rL) : (dir > 0 ? mH : mL)
float sl0 = dir > 0 ? rL - slBuf * nz(atr) : rH + slBuf * nz(atr)
float sl  = math.abs(close - sl0) < 0.3 * nz(atr) ? close - dir * 0.3 * nz(atr) : sl0
float rr  = math.abs(close - sl) > 0 ? math.abs(tp - close) / math.abs(close - sl) : 0.0

// ─── Seguimiento de cada operación y estadística ───
var array<float> aE   = array.new<float>()
var array<float> aTP  = array.new<float>()
var array<float> aSL  = array.new<float>()
var array<int>   aD   = array.new<int>()
var array<int>   aT   = array.new<int>()
var array<int>   aBar = array.new<int>()
var array<box>   aBox = array.new<box>()
// 0 compra dentro · 1 venta dentro · 2 compra al revés · 3 venta al revés
var array<int>   sN = array.new<int>(4, 0)
var array<int>   sW = array.new<int>(4, 0)
var array<float> sR = array.new<float>(4, 0.0)

f_idx(int d, bool r) => (r ? 2 : 0) + (d > 0 ? 0 : 1)

if barstate.isconfirmed and array.size(aE) > 0
    for k = array.size(aE) - 1 to 0
        int   dd   = array.get(aD, k)
        float e    = array.get(aE, k)
        float t    = array.get(aTP, k)
        float s    = array.get(aSL, k)
        float risk = math.abs(e - s)
        bool  hitSL = dd > 0 ? low <= s : high >= s
        bool  hitTP = dd > 0 ? high >= t : low <= t
        bool  fin   = bar_index - array.get(aBar, k) >= maxBars
        box   bx    = array.get(aBox, k)
        box.set_right(bx, bar_index)
        if hitSL or hitTP or fin
            float r = hitSL ? -1.0 : hitTP ? math.abs(t - e) / risk : (close - e) * dd / risk
            r -= risk > 0 ? spreadIn / risk : 0.0
            int ix = f_idx(dd, array.get(aT, k) == 2)
            array.set(sN, ix, array.get(sN, ix) + 1)
            if hitTP and not hitSL
                array.set(sW, ix, array.get(sW, ix) + 1)
            array.set(sR, ix, array.get(sR, ix) + r)
            box.set_bgcolor(bx, hitTP and not hitSL ? color.new(color.green, 82) : hitSL ? color.new(color.red, 85) : color.new(color.gray, 85))
            array.remove(aE, k)
            array.remove(aTP, k)
            array.remove(aSL, k)
            array.remove(aD, k)
            array.remove(aT, k)
            array.remove(aBar, k)
            array.remove(aBox, k)

f_pct(int ix) =>
    int n = array.get(sN, ix)
    n > 0 ? str.tostring(100.0 * array.get(sW, ix) / n, "0") + "% (" + str.tostring(n) + ")" : "sin casos aún"

if barstate.isconfirmed and dir != 0
    float bTop = rev ? rH : mH
    float bBot = rev ? rL : mL
    box b = box.new(bar_index - 1, bTop, bar_index, bBot, border_color = color.new(color.purple, 20), bgcolor = colRange)
    array.push(aE, close)
    array.push(aTP, tp)
    array.push(aSL, sl)
    array.push(aD, dir)
    array.push(aT, math.abs(sig))
    array.push(aBar, bar_index)
    array.push(aBox, b)
    if array.size(aE) > 100
        array.shift(aE)
        array.shift(aTP)
        array.shift(aSL)
        array.shift(aD)
        array.shift(aT)
        array.shift(aBar)
        array.shift(aBox)
    if showLines
        line.new(bar_index, tp, bar_index + 10, tp, color = color.new(color.green, 10), style = line.style_dashed)
        line.new(bar_index, sl, bar_index + 10, sl, color = color.new(color.red, 10), style = line.style_dashed)
    string que = rev ? (dir > 0 ? "madre al revés: va para ARRIBA" : "madre al revés: va para ABAJO") : (dir > 0 ? "busca el MÁXIMO del rango" : "busca el MÍNIMO del rango")
    string txt = (dir > 0 ? "▲ COMPRA · " : "▼ VENTA · ") + que + "\nEntrada " + str.tostring(close, format.mintick) + "\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " · R:R 1:" + str.tostring(rr, "0.0") + "\nHistorial: llegó " + f_pct(f_idx(dir, rev))
    label.new(bar_index, dir > 0 ? low : high, txt, style = dir > 0 ? label.style_label_up : label.style_label_down, color = dir > 0 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
    alert("🐋🟡 Rango madre · " + (dir > 0 ? "COMPRA " : "VENTA ") + syminfo.ticker + " (" + timeframe.period + ") · " + que + " · Entrada " + str.tostring(close, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " · SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)

alertcondition(dir > 0 and barstate.isconfirmed, "Rango madre · COMPRA", "🐋🟡 Rango madre: COMPRA en {{ticker}} ({{interval}}) a {{close}}")
alertcondition(dir < 0 and barstate.isconfirmed, "Rango madre · VENTA", "🐋🟡 Rango madre: VENTA en {{ticker}} ({{interval}}) a {{close}}")

// ─── Panel ───
var table panel = table.new(position.top_right, 4, 6, bgcolor = color.new(#111827, 5), border_color = color.new(color.gray, 70), border_width = 1)
f_cell(int c, int r, string t, color col) =>
    table.cell(panel, c, r, t, text_color = col, text_size = size.small)
if showTable and barstate.islast
    f_cell(0, 0, "🐋🟡 RANGO MADRE", color.yellow)
    f_cell(1, 0, "Casos", color.silver)
    f_cell(2, 0, "Llegó al TP", color.silver)
    f_cell(3, 0, "R por operación", color.silver)
    array<string> nombres = array.from("▲ Compra (verde dentro)", "▼ Venta (roja dentro)", "▲ Compra (madre al revés)", "▼ Venta (madre al revés)")
    for i = 0 to 3
        int   n  = array.get(sN, i)
        float ev = n > 0 ? array.get(sR, i) / n : 0.0
        f_cell(0, i + 1, array.get(nombres, i), color.white)
        f_cell(1, i + 1, str.tostring(n), color.white)
        f_cell(2, i + 1, n > 0 ? str.tostring(100.0 * array.get(sW, i) / n, "0") + "%" : "-", color.white)
        f_cell(3, i + 1, n > 0 ? str.tostring(ev, "+0.00;-0.00") : "-", ev > 0 ? color.lime : color.orange)
    f_cell(0, 5, "Spread descontado: " + str.tostring(spreadIn, format.mintick), color.gray)
